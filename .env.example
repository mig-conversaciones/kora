# KORA (proyecto Producción CAB) — variables de entorno (Anexo A del SRS).
# Copiar como .env FUERA de public_html (compartido/.env en Hostinger), permisos 600. Nunca versionar el .env real (RS-012).
# Generar claves con:  php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Token de monitoreo:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"

APP_NOMBRE="KORA"
# produccion | staging | local. «local» habilita las excepciones de desarrollo (MySQL 5.7 de MAMP, HTTP en localhost).
APP_ENTORNO=produccion
# URL pública sin barra final. En MAMP: http://localhost/dashboard_laila
APP_URL=https://kora.dominio-del-centro.gov.co
APP_ZONA_HORARIA=America/Bogota
APP_DEPURACION=false

# Base de datos: 127.0.0.1 desde la aplicación (indicación de Hostinger), nunca el host remoto srvNNNN.hstgr.io.
BD_HOST=127.0.0.1
BD_PUERTO=3306
BD_NOMBRE=
BD_USUARIO=
BD_CONTRASENA=
# false en MySQL 5.7 (local); true en MariaDB 10.6+ y MySQL 8.0+.
BD_SKIP_LOCKED=true

# Llavero de cifrado versionado: la primera clave cifra; todas descifran (rotación cada 90 días, D-15).
CLAVES_CIFRADO="v1:REEMPLAZAR_CON_32_BYTES_EN_BASE64"
CLAVE_HMAC_PII=REEMPLAZAR_CON_32_BYTES_EN_BASE64
CLAVE_HMAC_CODIGOS=REEMPLAZAR_CON_32_BYTES_EN_BASE64
TOKEN_MONITOREO=REEMPLAZAR_CON_64_CARACTERES_HEX

# Sesiones (RAC-019)
SESION_INACTIVIDAD_SEGUNDOS=1800
SESION_INACTIVIDAD_PRIVILEGIADOS_SEGUNDOS=900
SESION_ABSOLUTA_SEGUNDOS=43200
SESION_ABSOLUTA_PRIVILEGIADOS_SEGUNDOS=28800

# Correo SMTP del dominio (Hostinger): puerto 465 con TLS implícito o 587 con STARTTLS
# smtp (Hostinger) | archivo (desarrollo: guarda .eml en almacenamiento/correos; MAMP no tiene servidor de correo)
CORREO_TRANSPORTE=smtp
# Buzón que recibe las alertas operativas de la cola (RF-Q-016). Vacío: solo registro y notificación en la aplicación.
CORREO_ALERTAS=
CORREO_HOST=smtp.hostinger.com
CORREO_PUERTO=465
CORREO_CIFRADO=ssl
CORREO_USUARIO=
CORREO_CONTRASENA=
CORREO_REMITENTE=notificaciones@dominio-del-centro.gov.co
CORREO_NOMBRE_REMITENTE="KORA"

# Cola (config/cola.php, I1). skip_locked | actualizacion_condicional (obligatoria en MySQL 5.7).
COLA_CONDUCTOR=mysql
COLA_ESTRATEGIA_RECLAMO=skip_locked
COLA_LOTE=10
COLA_PRESUPUESTO_SEGUNDOS=50
COLA_MEMORIA_MAX_MB=192
COLA_MAX_TRABAJADORES=2

# Copias de seguridad cifradas (RDL-003, RS-019; ADR-021). Llave PÚBLICA del custodio, generada con
#   php cli/respaldo.php llaves --salida=DIR_FUERA_DEL_SERVIDOR
# El par completo (llave privada) nunca se guarda en el servidor: sin él no se abre ninguna copia.
RESPALDO_LLAVE_PUBLICA=
# Fuera de public_html y del almacenamiento compartido. En Hostinger: /home/USUARIO/domains/DOMINIO/kora/respaldos
RESPALDO_DIRECTORIO=
# Binarios del cliente. En MAMP: C:/MAMP/bin/mysql/bin/mysqldump.exe y C:/MAMP/bin/mysql/bin/mysql.exe
RESPALDO_MYSQLDUMP=mysqldump
RESPALDO_MYSQL=mysql
# Copia fuera de Hostinger: un directorio montado; o usuario@servidor:/ruta para el rsync de scripts/backup.sh
RESPALDO_DESTINO_EXTERNO=
RESPALDO_DIARIAS=30
RESPALDO_MENSUALES=12
# Una importación con al menos estas filas hace su copia previa (RDL-004); 0 la exige siempre
RESPALDO_IMPORTACION_FILAS=500

# Monitoreo del certificado (ROB-014): días de anticipación del aviso de vencimiento
SSL_AVISO_DIAS=15

# Caché y almacenamiento privado
CACHE_TAMANO_MAXIMO_MB=200

# Funcionalidades (sobrescriben config/funcionalidades.php; valores por defecto restrictivos, RS-023)
FUNCIONALIDAD_RECAUDOS_ALTA_MANUAL=false
FUNCIONALIDAD_HIBP_HABILITADO=false
FUNCIONALIDAD_CAPTCHA_TRAS_UMBRAL=false
FUNCIONALIDAD_VISTA_SOPORTE=false
